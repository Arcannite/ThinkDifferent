#!/usr/bin/env bash
# bin/backend — manage the third-party framework clone in ./backend
#
# backend/ is a full, independent git clone, ignored by the outer repo
# (see .gitignore). backend.lock records the upstream URL and the pinned
# commit, so this repo stays reproducible on a fresh machine or after the
# clone is lost.
#
# Usage:
#   bin/backend setup <upstream-url> [ref]   clone fresh, add upstream remote
#   bin/backend update [--rebase]            merge upstream changes, re-pin lock
#   bin/backend status                       drift / dirty / ahead-behind
#   bin/backend log                          incoming upstream commits
#
set -euo pipefail

ROOT=$(git -C "$(dirname "${BASH_SOURCE[0]}")/.." rev-parse --show-toplevel)
LOCK="$ROOT/backend.lock"
DIR="$ROOT/backend"
BRANCH=main

die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
info() { printf '  %s\n' "$*"; }

lock_get() { [ -f "$LOCK" ] && sed -n "s/^$1=//p" "$LOCK" | tail -1 || true; }

lock_put() { # key value
    local k=$1 v=$2 tmp
    tmp=$(mktemp)
    if [ -f "$LOCK" ]; then
        awk -v k="$k" -v v="$v" '
            BEGIN { done = 0 }
            index($0, k "=") == 1 { print k "=" v; done = 1; next }
            { print }
            END { if (!done) print k "=" v }
        ' "$LOCK" > "$tmp"
    else
        printf '%s=%s\n' "$k" "$v" > "$tmp"
    fi
    mv "$tmp" "$LOCK"
}

need_clone() {
    [ -d "$DIR/.git" ] || die "backend/ is not a clone yet; run: bin/backend setup <upstream-url> [ref]"
}

clean_or_die() {
    local dirty
    dirty=$(git -C "$DIR" status --porcelain)
    [ -z "$dirty" ] || {
        printf '%s\n' "$dirty" >&2
        die "backend/ has uncommitted changes — commit or stash them first, then re-run"
    }
}

cmd_setup() {
    local url=${1:-} ref=${2:-$(lock_get ref)}
    ref=${ref:-main}
    [ -n "$url" ] || url=$(lock_get url)
    [ -n "$url" ] || die "usage: bin/backend setup <upstream-url> [ref]"
    [ -e "$DIR/.git" ] && die "backend/.git already exists — use 'update'"

    if [ -d "$DIR" ] && [ -n "$(ls -A "$DIR")" ]; then
        die "backend/ exists and is not empty — move it aside first"
    fi

    git clone "$url" "$DIR"
    git -C "$DIR" remote rename origin upstream
    git -C "$DIR" config rerere.enabled true
    git -C "$DIR" config merge.conflictStyle zdiff3

    # the clone needs its own identity; inherit it when only the outer repo has one
    for k in user.name user.email; do
        if ! git -C "$DIR" config --get "$k" >/dev/null 2>&1; then
            v=$(git -C "$ROOT" config --get "$k" 2>/dev/null || true)
            [ -n "$v" ] && git -C "$DIR" config "$k" "$v"
        fi
    done

    lock_put url  "$url"
    lock_put ref  "$ref"
    lock_put sha  "$(git -C "$DIR" rev-parse HEAD)"
    lock_put updated "$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    echo "cloned $url -> backend/ at $(git -C "$DIR" rev-parse --short HEAD)"
    echo "next: commit your changes inside backend/, then push to your own fork and:"
    echo "      git -C backend remote add origin <your-fork-url>"
}

cmd_update() {
    local mode=${1:-merge}
    need_clone
    clean_or_die

    local url ref
    url=$(lock_get url); ref=$(lock_get ref); ref=${ref:-main}
    [ -n "$url" ] || die "backend.lock has no url= entry"

    git -C "$DIR" remote get-url upstream >/dev/null 2>&1 \
        || git -C "$DIR" remote add upstream "$url"

    git -C "$DIR" fetch upstream --prune --tags --quiet

    local incoming ahead
    incoming=$(git -C "$DIR" rev-list --count "HEAD..upstream/$ref")
    ahead=$(git -C "$DIR" rev-list --count "upstream/$ref..HEAD")
    echo "upstream/$ref: $incoming incoming, you are $ahead commit(s) ahead"

    if [ "$incoming" -eq 0 ]; then
        echo "already up to date"
        lock_put sha "$(git -C "$DIR" rev-parse HEAD)"
        return 0
    fi

    git -C "$DIR" log --oneline "HEAD..upstream/$ref" | sed 's/^/    /'

    set +e
    if [ "$mode" = "--rebase" ]; then
        git -C "$DIR" rebase "upstream/$ref"
    else
        git -C "$DIR" merge --no-edit "upstream/$ref"
    fi
    local rc=$?
    set -e

    if [ $rc -ne 0 ]; then
        cat >&2 <<'EOF'

Merge interrupted — resolve conflicts inside backend/, then either:
    git -C backend add <files> && git -C backend merge --continue
    git -C backend merge --abort          # to back out
backend.lock was NOT updated.
EOF
        exit $rc
    fi

    lock_put sha "$(git -C "$DIR" rev-parse HEAD)"
    lock_put updated "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "merged; pinned backend.lock to $(git -C "$DIR" rev-parse --short HEAD)"
}

cmd_status() {
    local url ref pin
    url=$(lock_get url); ref=$(lock_get ref); pin=$(lock_get sha)
    echo "lock: url=${url:-<unset>} ref=${ref:-<unset>} pin=${pin:-<none>}"

    if [ ! -d "$DIR/.git" ]; then
        echo "backend/: not set up — run: bin/backend setup ${url:-<upstream-url>}"
        return 0
    fi

    echo "branch: $(git -C "$DIR" rev-parse --abbrev-ref HEAD)  head: $(git -C "$DIR" rev-parse --short HEAD)"

    local dirty
    dirty=$(git -C "$DIR" status --porcelain)
    if [ -n "$dirty" ]; then
        echo "working tree: DIRTY ($(printf '%s\n' "$dirty" | wc -l) path(s))"
    else
        echo "working tree: clean"
    fi

    local head ahead behind
    head=$(git -C "$DIR" rev-parse HEAD)
    if git -C "$DIR" rev-parse --verify --quiet "upstream/$ref" >/dev/null; then
        ahead=$(git -C "$DIR" rev-list --count "upstream/$ref..HEAD")
        behind=$(git -C "$DIR" rev-list --count "HEAD..upstream/$ref")
        echo "vs upstream/$ref: ahead $ahead, behind $behind"
        [ "$behind" -gt 0 ] && echo "  -> run: bin/backend update"
    else
        echo "vs upstream/$ref: remote-tracking ref absent (never fetched?)"
    fi

    if [ -n "$pin" ] && [ "$pin" != "$head" ]; then
        echo "drift: HEAD is not the pinned commit; re-run 'update' to re-pin"
    fi

    local origin
    origin=$(git -C "$DIR" remote get-url origin 2>/dev/null || true)
    [ -n "$origin" ] || echo "warning: no 'origin' remote — your commits exist only on this disk"
    git -C "$DIR" config --get user.email >/dev/null 2>&1 \
        || echo "warning: no user.email in backend/ — commits there will fail"
}

cmd_log() {
    need_clone
    local ref; ref=$(lock_get ref); ref=${ref:-main}
    git -C "$DIR" fetch upstream --prune --quiet
    git -C "$DIR" log --oneline --graph --decorate "HEAD..upstream/$ref"
}

case "${1:-status}" in
    setup)  shift; cmd_setup  "$@" ;;
    update) shift; cmd_update "${1:-merge}" ;;
    status) cmd_status ;;
    log)    cmd_log ;;
    -h|--help|help) awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "${BASH_SOURCE[0]}" ;;
    *) die "unknown command '$1' (setup|update|status|log)" ;;
esac
